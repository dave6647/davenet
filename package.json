{
  "name": "davenet",
  "version": "0.1.0",
  "private": true,
  "description": "Davenet – provider-unabhängiges Multi-Agent-Unternehmen (lokaler Orchestrator + Verwaltungsoberfläche)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/static": "^10.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9"
  }
}
